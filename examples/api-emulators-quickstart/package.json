    "uptick-sim": "tsx src/uptick-sim.ts",
    "nango-providers-sim": "tsx src/nango-providers-sim.ts",
    "direct-sim": "tsx src/direct-sim.ts",
    "xero-quickbooks-webhooks": "tsx src/xero-quickbooks-webhooks.ts",
    "realtime-stream": "tsx src/realtime-stream.ts",
    "vercel": "tsx src/vercel.ts",
    "github": "tsx src/github.ts",
    "google": "tsx src/google.ts",
    "slack": "tsx src/slack.ts",
    "apple": "tsx src/apple.ts",
    "microsoft": "tsx src/microsoft.ts",
    "okta": "tsx src/okta.ts",
    "aws": "tsx src/aws.ts",
    "resend": "tsx src/resend.ts",
    "stripe": "tsx src/stripe.ts",
    "mongoatlas": "tsx src/mongoatlas.ts",
